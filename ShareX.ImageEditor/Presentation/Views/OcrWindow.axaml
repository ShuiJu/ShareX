<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:ShareX.ImageEditor.Localization"
        x:Class="ShareX.ImageEditor.Presentation.Views.OcrWindow"
        Title="{x:Static res:Strings.OcrWindow_Title}"
        Width="760" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ShareX.Brush.Background.Panel}">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="20,16" Spacing="10">
            <TextBlock x:Name="StatusText"
                       Text="{x:Static res:Strings.OcrWindow_Loading}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ShareX.Brush.Text.Secondary}"/>
            <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True"/>
        </StackPanel>

        <TextBox x:Name="ResultText" Grid.Row="1" Margin="20,0,20,16"
                 IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <Border Grid.Row="2" Background="{DynamicResource ShareX.Brush.Background.Toolbar}"
                BorderBrush="{DynamicResource ShareX.Brush.Border}" BorderThickness="0,1,0,0"
                Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Padding="16,0" IsEnabled="False"
                        Content="{x:Static res:Strings.OcrWindow_Save}" Click="OnSaveClick"/>
                <Button x:Name="CopyButton" Padding="16,0" IsEnabled="False"
                        Content="{x:Static res:Strings.OcrWindow_Copy}" Click="OnCopyClick"/>
                <Button Padding="16,0" Content="{x:Static res:Strings.OcrWindow_Close}"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
